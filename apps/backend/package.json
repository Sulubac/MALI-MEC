    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.17.0",
    "@anthropic-ai/sdk": "^0.27.3",
    "openai": "^4.57.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
