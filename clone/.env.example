# Copiez ce fichier en .env.local et remplissez les valeurs. Ne commitez jamais .env.local.

# Base Postgres (Supabase, Neon, ou un Postgres local). Exemple local :
# postgres://postgres@127.0.0.1:5432/scheduling_dev
DATABASE_URL=

# Adresse publique de l'application : sert aux liens des e-mails (sans « / » final)
APP_URL=http://localhost:3000

# E-mails transactionnels — Resend (https://resend.com), avec un domaine que vous possédez
RESEND_API_KEY=
# Expéditeur, sur le domaine vérifié chez Resend. Exemple : Planifier <rendez-vous@votre-domaine.fr>
EMAIL_FROM=
# Optionnel : « outbox » écrit les e-mails dans la table email_outbox (développement / essais locaux),
# « resend » force l'envoi réel. Sans valeur : Resend si RESEND_API_KEY existe, sinon outbox hors production.
EMAIL_TRANSPORT=

# Secret de l'appel de la file de tâches : GET /api/cron/jobs avec l'en-tête « Authorization: Bearer <secret> ».
# Générer : openssl rand -base64 32
CRON_SECRET=

# Tests uniquement : base dédiée, migrée, vidée à chaque test (ne JAMAIS pointer vers une vraie base)
TEST_DATABASE_URL=
