# Copiez ce fichier en .env.local et remplissez les valeurs. Ne commitez jamais .env.local.

# Base Postgres (Supabase, Neon, ou un Postgres local). Exemple local :
# postgres://postgres@127.0.0.1:5432/scheduling_dev
DATABASE_URL=

# Adresse publique de l'application : sert aux liens des e-mails (sans « / » final)
APP_URL=http://localhost:3000

# E-mails transactionnels — Resend (https://resend.com), avec un domaine que vous possédez
RESEND_API_KEY=
# Expéditeur, sur le domaine vérifié chez Resend. Exemple : Planifier <rendez-vous@votre-domaine.fr>
EMAIL_FROM=
# Optionnel : « outbox » écrit les e-mails dans la table email_outbox (développement / essais locaux),
# « resend » force l'envoi réel. Sans valeur : Resend si RESEND_API_KEY existe, sinon outbox hors production.
EMAIL_TRANSPORT=

# Secret de l'appel de la file de tâches : GET /api/cron/jobs avec l'en-tête « Authorization: Bearer <secret> ».
# Générer : openssl rand -base64 32
CRON_SECRET=

# Tests uniquement : base dédiée, migrée, vidée à chaque test (ne JAMAIS pointer vers une vraie base)
TEST_DATABASE_URL=

# ---- Google Agenda (optionnel) ----
# Créez un projet dans Google Cloud (https://console.cloud.google.com), activez « Google Calendar API », configurez l'écran de
# consentement OAuth, puis créez un identifiant « Application Web » dont l'URI de redirection autorisée est
# <APP_URL>/api/google/callback . Sans ces trois variables, la page « Calendrier » indique que la fonction n'est pas activée.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé de chiffrement des jetons stockés en base : 32 octets en base64. Générer : openssl rand -base64 32
# (la perdre oblige tous les utilisateurs à reconnecter leur agenda)
TOKEN_ENCRYPTION_KEY=
# Optionnel. Par défaut : calendar.freebusy + calendar.events (séparées par des espaces). Une portée d'écriture plus étroite
# (ex. calendar.events.owned) peut remplacer calendar.events : vérifiez son nom dans la documentation Google avant de l'utiliser.
GOOGLE_CALENDAR_SCOPES=
