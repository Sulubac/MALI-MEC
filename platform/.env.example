# ===============================================================
#  Djibouti Event Intelligence — configuration serveur
#  Copiez ce fichier en « .env » et renseignez vos valeurs.
#  AUCUNE de ces clés n'est jamais envoyée au navigateur.
# ===============================================================

# Port d'écoute du serveur
PORT=3000

# Secret pour signer les jetons de session (JWT). METTEZ UNE VALEUR ALÉATOIRE LONGUE EN PRODUCTION.
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Emplacement du fichier de base de données SQLite (optionnel)
# DB_PATH=./data.sqlite

# --- Intégration IA temps réel (optionnelle) ---
# Si renseignée, les agents utilisent le modèle Anthropic pour rédiger leurs résumés.
# Sinon, les agents fonctionnent en mode simulé (déterministe). La clé reste côté serveur.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Emplacements pour intégrations futures (email, WhatsApp, paiement, etc.) ---
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# WHATSAPP_TOKEN=
# SMS_API_KEY=

# --- Envoi réel d'emails (SMTP) ---
# Exemple Hostinger : host smtp.hostinger.com, port 465, secure true, user = votre email de domaine.
# Exemple Gmail     : host smtp.gmail.com, port 465, secure true, user = votre Gmail, pass = mot de passe d'application.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@techiftiin.online
# SMTP_PASS=votre-mot-de-passe-email
# SMTP_FROM=Djibouti Events <contact@techiftiin.online>
